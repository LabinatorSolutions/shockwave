#!/bin/sh
# ============================================================================
# The ONE command installed on this server.
#
# Everything you can run on the box is a subcommand here, and this file ships
# with the release like any other runtime file — so a new subcommand arrives
# with a normal upgrade and NOTHING new is ever installed on the box.
#
# That property is the whole design. /usr/local/bin/shockwave is a symlink to
# this file, created once by install.sh. The path it points at never changes,
# so the upgrade never needs to write outside the install directory — which it
# cannot do anyway (updater/watch.sh mounts only that directory into the helper
# that runs apply.sh). The previous shape — one script per command, each
# generated by install.sh and symlinked separately — meant every new command
# was a host file that upgrades had no way to deliver. They silently never
# appeared, and boxes installed before a command existed simply never got it.
#
# So: add commands HERE. Never add another file under /usr/local/bin.
# ============================================================================
set -eu

DIR="${COMPANION_DIR:-/opt/shockwave-companion}"
CERT=/etc/traefik/dynamic/companion.crt
KEY=/etc/traefik/dynamic/companion.key

# Subshell: this must not change the caller's working directory.
compose() { (cd "$DIR" && docker compose "$@"); }

fingerprint() {
  compose exec -T api openssl x509 -in "$CERT" -noout -fingerprint -sha256
}

usage() {
  cat <<'EOF'
Usage: shockwave <command>

  fingerprint    Print this server's TLS certificate fingerprint — the value the
                 desktop app shows you to compare before you approve it.
  rotate-cert    Replace the certificate. Every desktop stops connecting until
                 the new fingerprint is approved; that is the point — this is
                 the recovery for a stolen private key.
  status         Container status.
  logs [service] Follow logs (default: api).
  version        The release this server is running.
EOF
}

case "${1:-}" in
  fingerprint)
    fingerprint
    ;;
  rotate-cert)
    # Delete it and let boot create a fresh one (settleTls). One code path, no
    # second implementation to drift. Traefik's file watcher picks it up.
    compose exec -T api rm -f "$CERT" "$KEY"
    compose restart api >/dev/null
    printf 'New fingerprint — approve this in the desktop app:\n'
    sleep 3
    fingerprint
    ;;
  status)
    compose ps
    ;;
  logs)
    shift
    compose logs -f --tail=200 "${1:-api}"
    ;;
  version)
    compose exec -T api sh -c 'printf "%s\n" "${APP_VERSION:-dev}"'
    ;;
  '' | -h | --help | help)
    usage
    ;;
  *)
    printf 'shockwave: unknown command: %s\n\n' "$1" >&2
    usage >&2
    exit 1
    ;;
esac
