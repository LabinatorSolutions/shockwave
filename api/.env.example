# Copy to .env and fill in. All required.

# Postgres password (the DB is private to the compose network).
POSTGRES_PASSWORD=

# 32 random bytes, base64 — the master key that encrypts all secrets.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY=

# The bearer token every desktop client sends.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
API_KEY=

# ── TLS / public host (optional) ─────────────────────────────────────────────
# Only SET this for a real signed domain (Let's Encrypt) or an ngrok host. Leave
# it EMPTY on a public server: the companion auto-detects its public IP and mints
# a self-signed cert (Traefik serves it; Telegram gets the PEM uploaded). The
# desktop trusts the self-signed cert too (see Settings).
COMPANION_DOMAIN=
# Email for Let's Encrypt registration (recommended when COMPANION_DOMAIN is set).
ACME_EMAIL=
