# Copy to .env and fill in. The installer generates all of this for you.

# Postgres password (the DB is private to the compose network).
POSTGRES_PASSWORD=

# 32 random bytes, base64 — the master key that encrypts all secrets.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY=

# The bearer token every desktop client sends.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
API_KEY=

# ── Public address + TLS ─────────────────────────────────────────────────────
# This server's public address. REQUIRED when COMPANION_DOMAIN is empty: the
# self-signed certificate is issued for it at boot, and it has to match the URL
# you type into the desktop. The installer resolves and writes it — the server
# deliberately does NOT look it up at runtime, because two lookups can disagree
# and then the certificate is for one address while you connect to another.
COMPANION_HOST=

# Only SET this for a real signed domain (Let's Encrypt) or an ngrok host. Leave
# it EMPTY on a public server with no domain: the certificate is then self-signed,
# and you approve its fingerprint once in the desktop app.
#
# NOT an IP address — Let's Encrypt only issues for names. An IP here is treated
# as COMPANION_HOST at boot (with a warning) rather than left to produce a new
# certificate on every restart; put it in COMPANION_HOST above instead.
#
# Setting this DELETES the self-signed certificate at the next boot — a real one is
# in play, so keeping a spare private key that claims to be this server is pure
# risk with nothing using it.
COMPANION_DOMAIN=

# Where Let's Encrypt sends expiry warnings. Optional — certificates still issue
# without it. Only used when COMPANION_DOMAIN is set.
COMPANION_CERT_EMAIL=
