# Copy to .env and fill in. All required.

# Postgres password (the DB is private to the compose network).
POSTGRES_PASSWORD=

# 32 random bytes, base64 — the master key that encrypts all secrets.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY=

# The bearer token every desktop client sends.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
API_KEY=

# ── TLS (optional) ───────────────────────────────────────────────────────────
# Leave COMPANION_DOMAIN empty → Traefik serves a self-signed cert (fine for a
# private companion; the desktop trusts it on first connect). Set it to a domain
# that resolves to this host → Traefik issues a real Let's Encrypt cert.
COMPANION_DOMAIN=
# Email for Let's Encrypt registration (recommended when COMPANION_DOMAIN is set).
ACME_EMAIL=
